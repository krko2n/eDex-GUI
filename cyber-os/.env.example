# CYBER-OS Environment Configuration
# Copy this to .env and configure as needed

# Backend Server Port
PORT=3001

# AI/LLM Configuration
# Point to a local Ollama instance or compatible API
AI_API_ENDPOINT=http://localhost:11434/api/generate
AI_MODEL=neural-chat

# Shell Configuration
SHELL=/bin/bash

# Home Directory
HOME=/home/username

# Debug Mode
DEBUG=false

# Node Environment
NODE_ENV=production

# Display Configuration
DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=1080
FULLSCREEN=true

# Network Configuration
API_TIMEOUT=5000
WS_TIMEOUT=10000

# Logging
LOG_LEVEL=info
